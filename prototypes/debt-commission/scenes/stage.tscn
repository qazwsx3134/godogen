[node name="Stage" type="Control" unique_id=1564831491]
editor_description = "舞台：背景與角色站位。
背景：Backgrounds 底下每個 node 對應 asset_catalog.json 的一個背景 id，拖它的邊框就能調整取景（圖片等比填滿框、置中裁切）；圖以 catalog 為準，這裡的圖只是預覽。沒有自己 node 的背景用 Default。
站位：StageArea 底下 left/center/right 是故事 char(…, 位置) 的三個通用站位，誰都能站，主角通常在 left。框的底邊是腳底線、對齊框的中線；框的高度是標準身高，角色各自的大小與取景在 scenes/characters/<角色>.tscn。名字不要改。"
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2


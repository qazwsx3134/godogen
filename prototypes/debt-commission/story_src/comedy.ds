    {
      "id": "node:5",
      "type": "ACTION",
      "position": "(460.0, 600.0)",
      "description": "char(\"kagura\", \"smile\", \"right\")",
      "action_type": "SCRIPT",
      "action_script_ref": "",
      "values": []
    },
    {
      "id": "node:6",
      "type": "DIALOGUE",
      "position": "(460.0, 800.0)",
      "character": "uid://caci80tc5curv::gintoki",
      "text": "今天也完全沒有工作啊。",
      "text_translation_key": ""
    },
    {
      "id": "node:7",
      "type": "DIALOGUE",
      "position": "(460.0, 1000.0)",
      "character": "uid://caci80tc5curv::shinpachi",
      "text": "不是沒有，是你全部都拒絕掉了吧！",
      "text_translation_key": ""
    },
    {
      "id": "node:8",
      "type": "DIALOGUE",
      "position": "(460.0, 1200.0)",
      "character": "uid://caci80tc5curv::kagura",
      "text": "阿銀今天已經睡第三次了阿魯。",
      "text_translation_key": ""
    },
    {
      "id": "node:9",
      "type": "DIALOGUE",
      "position": "(460.0, 1400.0)",
      "character": "uid://caci80tc5curv::gintoki",
      "text": "沒有工作的時候休息不是很合理嗎？",
      "text_translation_key": ""
    },
    {
      "id": "node:10",
      "type": "ACTION",
      "position": "(460.0, 1600.0)",
      "description": "comedy(\"tsukkomi_impact\", \"shinpachi\", \"問題是你有工作的時候也在休息啊！！\")",
      "action_type": "SCRIPT",
      "action_script_ref": "",
      "values": []
    },
    {
      "id": "node:11",
      "type": "DIALOGUE",
      "position": "(460.0, 1800.0)",
      "character": "uid://caci80tc5curv::gintoki",
      "text": "……嗯？剛剛是不是有什麼東西在吵？",
      "text_translation_key": ""
    },
    {
      "id": "node:12",
      "type": "DIALOGUE",
      "position": "(920.0, 0.0)",
      "character": "uid://caci80tc5curv::kagura",
      "text": "阿銀，你剛剛絕對裝作沒聽到阿魯。",
      "text_translation_key": ""
    },
    {
      "id": "node:13",
      "type": "ACTION",
      "position": "(920.0, 200.0)",
      "description": "comedy(\"small_reaction\", \"gintoki\", \"……嗶～\")",
      "action_type": "SCRIPT",
      "action_script_ref": "",
      "values": []
    },
    {
      "id": "node:14",
      "type": "DIALOGUE",
      "position": "(920.0, 400.0)",
      "character": "uid://caci80tc5curv::shinpachi",
      "text": "不要吹口哨矇混過去啊！",
      "text_translation_key": ""
    },
    {
      "id": "node:15",
      "type": "DIALOGUE",
      "position": "(920.0, 600.0)",
      "character": "uid://caci80tc5curv::gintoki",
      "text": "好啦好啦。那你說說看，上一次有委託是什麼時候？",
      "text_translation_key": ""
    },
    {
      "id": "node:16",
      "type": "DIALOGUE",
      "position": "(920.0, 800.0)",
      "character": "uid://caci80tc5curv::shinpachi",
      "text": "三個月前，找貓。而且還被貓抓了。",
      "text_translation_key": ""
    },
    {
      "id": "node:17",
      "type": "DIALOGUE",
      "position": "(1380.0, 0.0)",
      "character": "uid://caci80tc5curv::kagura",
      "text": "這個月的房租也還沒付阿魯。",
      "text_translation_key": ""
    },
    {
      "id": "node:18",
      "type": "ACTION",
      "position": "(1380.0, 200.0)",
      "description": "comedy(\"full_manga_panel\", \"新八\", \"全部都是赤字啊啊啊！！\")",
      "action_type": "SCRIPT",
      "action_script_ref": "",
      "values": []
    },
    {
      "id": "node:19",
      "type": "DIALOGUE",
      "position": "(1380.0, 400.0)",
      "character": "uid://caci80tc5curv::gintoki",
      "text": "……今天先睡吧。",
      "text_translation_key": ""
    },
    {
      "id": "node:20",
      "type": "ACTION",
      "position": "(1380.0, 600.0)",
      "description": "comedy(\"tsukkomi_impact\", \"shinpachi\", \"現在是工作時間吧！！！\")",
      "action_type": "SCRIPT",
      "action_script_ref": "",
      "values": []
    },
    {
      "id": "node:21",
      "type": "DIALOGUE",
      "position": "(1380.0, 800.0)",
      "character": "uid://caci80tc5curv::kagura",
      "text": "阿銀已經睡著了阿魯。",
      "text_translation_key": ""
    },
    {
      "id": "node:22",
      "type": "ACTION",
      "position": "(1380.0, 1000.0)",
      "description": "end(\"漫畫吐槽技術片段到此為止。\")",

[resource]
script = ExtResource("1_2uq6b")
id = &"wood"
title = "木遁・樹界降誕"
kind = 4
summary = "樹根從敵群腳下竄出，把一整圈敵人綁在原地。"
level_texts = PackedStringArray("樹海更大，綁得更久。", "樹海再擴大。", "一次長出兩片樹海（前後各一）。", "學過火遁時，樹根會著火，把綁住的人一起燒。")

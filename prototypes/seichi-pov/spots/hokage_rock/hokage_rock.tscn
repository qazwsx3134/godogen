[node name="HokageRock" type="Node3D" unique_id=496177021]
script = ExtResource("1_xi8wp")
display_name = "火影岩"
subtitle = "木葉隱村 · 歷代火影的臉"
intro = "刻在木葉村後方岩壁上的歷代火影頭像。由左至右為初代千手柱間、二代千手扉間、三代猿飛日斬、四代波風湊。

你站在村子中央的展望台上：左下搖桿走動，拖曳畫面環顧，雙指或「望遠鏡」拉近細看。"
source_note = "私人同人原型，非官方內容；造型依動畫印象程序生成。"


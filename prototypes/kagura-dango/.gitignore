# Godot's import cache and editor state: rebuilt by `godot --headless --editor --quit`
.godot/

# Web export (build_web.sh output): rebuilt from source, not versioned
build/

# Raw image-generation output and source fonts: local only
art_src/gen/
art_src/fonts/

# Kit copy: this game does not use the VFX library (14 MB, ~1000 files); sync.sh copies it, git skips it
addons/proto_kit/vfx/

# Songs are baked from data/songs/*.json by tools/bake_music.py (deterministic): run it after a clone.
# The short sound effects in assets/sfx/ stay versioned because scenes reference them.
assets/music/*.wav
assets/music/*.wav.import

# The user's reference screenshots and the songs (copyrighted originals): local only, never in this public repo.
# Put the three songs in assets/music/; each chart's "music" names its file (the chart maker can switch it).
assets/example/
assets/music/*.mp3
assets/music/*.mp3.import

# Voice clips recorded from the show (copyrighted): local only. tools/convert_voice.sh cleans assets/sfx/*.MOV into
# assets/voice/*.wav; the game skips any clip that is missing.
assets/sfx/*.MOV
assets/sfx/*.mov

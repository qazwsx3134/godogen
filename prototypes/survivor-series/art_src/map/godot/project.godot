; Standalone Godot 4 project for the exported C map.
; Root should open/import this folder with Godot 4.7 before accepting it.
config_version=5

[application]

config/name="Survivor Series D - Night Market"
run/main_scene="res://survivor-series-D-night-market.tscn"

[display]

window/size/viewport_width=1536
window/size/viewport_height=1536
window/size/window_width_override=1536
window/size/window_height_override=1536
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor]

run/main_run_args=""

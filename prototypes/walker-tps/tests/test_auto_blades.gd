extends "res://addons/proto_kit/test_kit.gd"
func _init() -> void: _run.call_deferred()
func _run() -> void:
	var main: Node = load("res://scenes/battlefield.tscn").instantiate()
	root.add_child(main)
	current_scene=main
	main.start_match()
	for enemy: Node in main.get_node("Enemies").get_children(): enemy.ai_enabled=false
	var walker: CharacterBody3D = main.get_node("Walker")
	var blades: Node = walker.get_node("Combat/AutoBlades")
	var enemy: Node3D = main.get_node("Enemies/Scout0")
	await _frames(20)
	enemy.global_position=walker.global_position+Vector3(0,0,2.8)
	await _frames(16)
	_expect(enemy.health==50,"front enemy automatically takes one 30-damage blade strike")
	_expect(blades.attack_count==1 and blades.hit_count==1,"one swipe hits once, not every frame")
	await _frames(20)
	_expect(enemy.health==50,"attack interval prevents continuous damage")
	await _frames(90)
	_expect(enemy.dead and main.kills==1,"automatic repeated swipes destroy scout and update mission")
	enemy=main.get_node("Enemies/Scout1")
	enemy.global_position=walker.global_position+Vector3(0,0,12)
	var combat: Node = walker.get_node("Combat")
	combat.grapple.launch_hooks(enemy.global_position+Vector3.UP*1.1)
	await _frames(200)
	_expect(enemy.dead and main.kills==2,"reeling a light enemy automatically chains into lethal blade attacks")
	enemy=main.get_node("Enemies/Scout2")
	var safe_health: float = enemy.health
	enemy.global_position=walker.global_position+Vector3(0,0,2.8)
	var wall := StaticBody3D.new()
	var collision := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size=Vector3(8,6,0.2)
	collision.shape=shape
	wall.add_child(collision)
	main.add_child(wall)
	wall.global_position=walker.global_position+Vector3(0,2,1.7)
	await _frames(40)
	_expect(enemy.health==safe_health,"wall prevents automatic blade damage")
	enemy.global_position=walker.global_position+Vector3(0,0,-2.8)
	await _frames(40)
	_expect(enemy.health==safe_health,"rear enemy is outside the front blade arc")
	enemy.global_position=walker.global_position+Vector3(0,4,2.8)
	await _frames(40)
	_expect(enemy.health==safe_health,"enemy on a higher floor is out of blade reach")
	wall.queue_free()
	await _frames(3)
	blades.cooldown_left=0
	enemy.global_position=walker.global_position+Vector3(0,0,2.8)
	await _frames(2)
	_expect(blades.windup_left>0,"automatic swipe has a windup before damage")
	enemy.global_position=walker.global_position+Vector3(0,0,7)
	await _frames(16)
	_expect(enemy.health==safe_health,"enemy leaving during windup avoids the blade")
	enemy.global_position=walker.global_position+Vector3(0,0,2.8)
	main.finish("defeat")
	await _frames(90)
	_expect(enemy.health==safe_health and not blades.get_node("Sweeps").visible,"round end stops automatic attacks and visuals")
	_finish("AUTO_BLADES")
